{
  "name": "b3forge",
  "version": "0.2.0",
  "description": "Project-local, cross-harness workflow for AI-assisted development with safe installation lifecycle management.",
  "bin": {
    "agentic-init": "bin/cli.js"
  },
  "scripts": {
    "build:test": "tsc -p test/tsconfig.json",
    "typecheck": "tsc -p test/tsconfig.json --noEmit",
    "test": "tsc -p test/tsconfig.json && node --test \".test-dist/*.test.js\""
  },
  "files": [
    "bin",
    ".agentic",
    ".agents",
    ".claude",
    "!.claude/worktrees",
    ".codex",
    ".cursor",
    ".github",
    "!.github/workflows",
    "AGENTS.md",
    "ai-workspace",
    "CHANGELOG.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "LESSONS.md",
    "SECURITY.md",
    "SETUP.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agentic",
    "codex",
    "cursor",
    "copilot",
    "ai-workflow",
    "mcp",
    "graphify",
    "scaffold"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BasudevBharatBhushan/B3Forge.git"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
